# Offline-only readiness runtime. Build from reviewed source, pin image digest before release.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080 HOST=0.0.0.0
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --include=dev --ignore-scripts && npm cache clean --force
USER node
EXPOSE 8080
CMD ["node", "--import", "tsx", "packages/runtime-server/src/main.ts"]
