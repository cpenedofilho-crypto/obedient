{
  "name": "obedient-musica",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "App do Music Intelligence Engine (D31, F3): lê a frequência cardíaca por Bluetooth, decide no aparelho com @obedient/music-engine e toca o catálogo próprio.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"shims/**/*.test.ts\"",
    "licenses": "node ../../scripts/check-licenses.mjs package-lock.json",
    "bundle": "expo export --platform android --output-dir dist-export"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ble-plx": "3.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
